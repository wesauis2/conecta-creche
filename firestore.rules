rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function roleDoc(userId) {
      return get(/databases/$(database)/documents/user_roles/$(userId));
    }

    function ownRole() {
      return roleDoc(request.auth.uid).data.role;
    }

    function rank(role) {
      return role == 'admin' ? 4
        : role == 'gestao' ? 3
        : role == 'cuidador' ? 2
        : role == 'responsavel' ? 1
        : 0;
    }

    function hasRole() {
      return signedIn()
        && exists(/databases/$(database)/documents/user_roles/$(request.auth.uid));
    }

    // Presence access matrix (CONTEXT.md "Cuidador+"): mirrors
    // canOperatePresence/canInactivateChild/canAdminPresence in
    // lib/users/user_role.dart.
    function isCaregiverPlus() {
      return hasRole() && rank(ownRole()) >= 2;
    }

    function isGestaoPlus() {
      return hasRole() && rank(ownRole()) >= 3;
    }

    function isAdmin() {
      return hasRole() && rank(ownRole()) == 4;
    }

    function isManager() {
      return isGestaoPlus();
    }

    function isResponsavelPlus() {
      return hasRole() && rank(ownRole()) >= 1;
    }

    function isValidRole(role) {
      return role in ['admin', 'gestao', 'cuidador', 'responsavel', 'convidado'];
    }

    function onlyRoleFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['role', 'updatedAt']);
    }

    // Vínculo criança↔responsável: uid ∈ children.responsibleUids.
    function childData(childId) {
      return get(/databases/$(database)/documents/children/$(childId)).data;
    }

    function isLinkedResponsible(childId) {
      return signedIn()
        && childId is string
        && exists(/databases/$(database)/documents/children/$(childId))
        && request.auth.uid in childData(childId).responsibleUids;
    }

    function canReadChildDoc() {
      return isCaregiverPlus()
        || (signedIn() && request.auth.uid in resource.data.responsibleUids);
    }

    function canReadPresenceRecord() {
      return isCaregiverPlus()
        || isLinkedResponsible(resource.data.childId);
    }

    function canReadPresenceRecordId(recordId) {
      return isCaregiverPlus()
        || isLinkedResponsible(
             get(/databases/$(database)/documents/presence_records/$(recordId))
               .data.childId);
    }

    function isMuralReleased() {
      return resource.data.releasedAt is timestamp
        && resource.data.releasedAt <= request.time;
    }

    function canReadMuralPost() {
      return isGestaoPlus()
        || (isResponsavelPlus() && isMuralReleased());
    }

    function canReadNotification() {
      return signedIn()
        && (
          !('userId' in resource.data.keys())
          || resource.data.userId == null
          || resource.data.userId == request.auth.uid
        );
    }

    // ---------------------------------------------------------------------------
    // Matriz FINAL — docs/requisitos/papeis-acesso.md
    // Publish manual: docs/firestore-rules.md (não há deploy automático).
    //
    // | Coleção / campo              | Read                               | Write                                |
    // |------------------------------|------------------------------------|--------------------------------------|
    // | users                        | dono ou gestão+                    | dono (sem `role`)                    |
    // | user_roles                   | dono ou gestão+                    | create self=convidado; update gestão+|
    // | children                     | Cuidador+; responsável só vinculados | create/rename Cuidador+; active e `responsibleUids` gestão+ |
    // | presence_records             | Cuidador+; responsável só de vinculados | create/close/parecer Cuidador+; admin corrige/apaga |
    // | presence_records/*/answers   | mesmos leitores do registro        | create/update Cuidador+ (janela 24h no app) |
    // | form_questions               | Cuidador+                          | gestão+                              |
    // | mural_posts                  | rank ≥ responsável + releasedAt; gestão+ vê pré-liberação | gestão+ |
    // | notifications                | destinatário (+ broadcast)         | gestão+                              |
    // | fcm_tokens                   | dono                               | dono                                 |
    // | levels / classes / classrooms| Cuidador+                          | gestão+                              |
    // | mural_reads                  | dono; gestão+ lista                | dono (próprio uid)                   |
    // ---------------------------------------------------------------------------

    match /users/{userId} {
      allow get, list: if isOwner(userId) || isManager();
      allow create, update: if isOwner(userId)
        && !request.resource.data.keys().hasAny(['role']);
      allow delete: if false;
    }

    match /user_roles/{userId} {
      allow get, list: if isOwner(userId) || isManager();

      allow create: if isOwner(userId)
        && !exists(/databases/$(database)/documents/user_roles/$(userId))
        && request.resource.data.role == 'convidado';

      allow update: if isManager()
        && request.auth.uid != userId
        && onlyRoleFieldsChanged()
        && isValidRole(request.resource.data.role)
        && request.resource.data.createdAt == resource.data.createdAt
        && rank(resource.data.role) <= rank(ownRole())
        && rank(request.resource.data.role) <= rank(ownRole());

      allow delete: if false;
    }

    // `children` catalog (CONTEXT.md "Criança" / "Vínculo criança↔responsável").
    function onlyChildFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['name', 'active', 'responsibleUids', 'updatedAt', 'updatedBy']);
    }

    function onlyChildNameFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['name', 'updatedAt', 'updatedBy']);
    }

    function childActiveUnchanged() {
      return request.resource.data.active == resource.data.active;
    }

    function childResponsibleUidsUnchanged() {
      return request.resource.data.responsibleUids == resource.data.responsibleUids;
    }

    function childCreateLinksOk() {
      return !('responsibleUids' in request.resource.data.keys())
        || request.resource.data.responsibleUids.size() == 0
        || isGestaoPlus();
    }

    match /children/{childId} {
      allow get, list: if canReadChildDoc();

      allow create: if isCaregiverPlus()
        && request.resource.data.name is string
        && request.resource.data.active == true
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && childCreateLinksOk();

      allow update: if request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && (
          (isGestaoPlus() && onlyChildFieldsChanged())
          || (isCaregiverPlus()
              && onlyChildNameFieldsChanged()
              && childActiveUnchanged()
              && childResponsibleUidsUnchanged())
        );

      allow delete: if false;
    }

    // `presence_records` (CONTEXT.md "Registro de presença" / "Chegada" /
    // "Saída"). Cuidador+ create chegada, close (form answers e/ou parecer
    // legado) e edita parecer depois; `childId`/`dayKey`/`arrivedAt` e um
    // `departedAt` já definido são imutáveis fora do admin.
    function presenceCoreFieldsUnchanged() {
      return request.resource.data.childId == resource.data.childId
        && request.resource.data.dayKey == resource.data.dayKey
        && request.resource.data.arrivedAt == resource.data.arrivedAt;
    }

    function isPresenceClosing() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['departedAt', 'isOpen', 'parecer', 'updatedAt', 'updatedBy'])
        && resource.data.departedAt == null
        && request.resource.data.departedAt != null
        && request.resource.data.isOpen == false;
    }

    function isPresenceParecerEdit() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['parecer', 'updatedAt', 'updatedBy'])
        && resource.data.departedAt != null;
    }

    match /presence_records/{recordId} {
      allow get, list: if canReadPresenceRecord();

      allow create: if isCaregiverPlus()
        && request.resource.data.departedAt == null
        && request.resource.data.isOpen == true
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid;

      allow update: if isAdmin()
        || (isCaregiverPlus()
            && presenceCoreFieldsUnchanged()
            && (isPresenceClosing() || isPresenceParecerEdit()));

      allow delete: if isAdmin();

      // Answers/ocorrências (CONTEXT.md "Resposta" / "Incidente").
      // Mesmos leitores do registro; write Cuidador+ (app aplica janela 24h).
      match /answers/{answerId} {
        allow get, list: if canReadPresenceRecordId(recordId);
        allow create, update: if isCaregiverPlus();
        allow delete: if false;
      }
    }

    // `form_questions` (CONTEXT.md "Formulário configurável").
    match /form_questions/{questionId} {
      allow get, list: if isCaregiverPlus();
      allow create, update: if isGestaoPlus();
      allow delete: if false;
    }

    // `mural_posts` (CONTEXT.md "Mural").
    // rank ≥ responsável + releasedAt; gestão+ vê pré-liberação.
    // Write só gestão+ (cuidador NÃO publica na v1).
    match /mural_posts/{postId} {
      allow get, list: if canReadMuralPost();
      allow create, update: if isGestaoPlus();
      allow delete: if false;
    }

    // `notifications` (CONTEXT.md "Mural" — registro local; FCM depois).
    // Destinatário lê as próprias (+ broadcast sem userId); write gestão+.
    match /notifications/{notificationId} {
      allow get, list: if canReadNotification();
      allow create, update: if isGestaoPlus();
      allow delete: if false;
    }

    // Placeholder — docs/requisitos/notificacoes-push.md (ticket FCM).
    match /fcm_tokens/{tokenId} {
      allow get, list: if signedIn()
        && resource.data.uid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid;
    }

    // Placeholders — docs/requisitos/niveis-turmas.md (RF0010).
    match /levels/{levelId} {
      allow get, list: if isCaregiverPlus();
      allow create, update: if isGestaoPlus();
      allow delete: if false;
    }

    match /classes/{classId} {
      allow get, list: if isCaregiverPlus();
      allow create, update: if isGestaoPlus();
      allow delete: if false;
    }

    match /classrooms/{classroomId} {
      allow get, list: if isCaregiverPlus();
      allow create, update: if isGestaoPlus();
      allow delete: if false;
    }

    // Placeholder — docs/requisitos/mural-leitura.md (RF0016).
    match /mural_reads/{readId} {
      allow get: if signedIn()
        && (resource.data.uid == request.auth.uid || isGestaoPlus());
      allow list: if isGestaoPlus()
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }
  }
}
